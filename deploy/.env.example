# Copy to deploy/.env on the server. Never commit the real .env.

# Public hostname. <server-ip-with-dashes>.sslip.io gives free HTTPS with no domain.
DOMAIN=172-105-12-34.sslip.io

# stub | akamai | bedrock
MODEL_PROVIDER=stub

# Akamai hosted inference (OpenAI-compatible, supports tool calling).
# Source: github.com/akamai-developers/akamai-workshop-hackmidwest docs/inference.md
# The team API key comes from the organizers. Keep it on the server only.
AKAMAI_BASE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_API_KEY=
AKAMAI_MODEL=hackathon-chat

# Amazon Bedrock (fallback)
BEDROCK_MODEL=
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Seconds between scheduled monitor re-checks
RECHECK_SECONDS=600

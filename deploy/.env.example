# Copy to deploy/.env on the server. Never commit the real .env.

# Public hostname. <server-ip-with-dashes>.sslip.io gives free HTTPS with no domain.
DOMAIN=172-105-12-34.sslip.io

# stub | akamai | bedrock | openai
MODEL_PROVIDER=stub

# Akamai hosted inference (OpenAI-compatible, supports tool calling).
# Source: github.com/akamai-developers/akamai-workshop-hackmidwest docs/inference.md
# The team API key comes from the organizers. Keep it on the server only.
AKAMAI_BASE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_API_KEY=
AKAMAI_MODEL=hackathon-chat

# Any OpenAI-compatible service (temporary fallback; the model then runs outside Akamai)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Amazon Bedrock (fallback)
BEDROCK_MODEL=
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DevRev follow-up board MCP connector (https://DOMAIN/mcp). Bearer secret, >= 32 random chars.
# Generate on the server:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Paste it ONLY here and in DevRev's secure connector form. Never in chat, a skill or git.
MCP_TOKEN=

# Optional: copy "customer will pay later" updates into DevRev as comments.
# DEVREV_PAT from DevRev Settings > Account > Personal Access Token; DEVREV_OBJECT_ID = the DevRev
# object (account or task) to comment on. Leave empty to skip; the website still works.
DEVREV_PAT=
DEVREV_OBJECT_ID=

# Seconds between scheduled monitor re-checks
RECHECK_SECONDS=600

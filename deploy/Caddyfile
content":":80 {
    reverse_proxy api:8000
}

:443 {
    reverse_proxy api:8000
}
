version: '3.9'
services:
  api:
    build: .
    working_dir: /app
    command: uvicorn app.main:app --host 0.0.0.0 --port 8000
    ports:
      - "8000:8000"
    environment:
      - MODEL_PROVIDER=${MODEL_PROVIDER:-stub}
    volumes:
      - .:/app

  frontend:
    build: .
    working_dir: /app
    command: streamlit run frontend/app.py --server.address 0.0.0.0 --server.port 8501
    ports:
      - "8501:8501"
    environment:
      - API_BASE=${API_BASE:-http://api:8000}
    volumes:
      - .:/app

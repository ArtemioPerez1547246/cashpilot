from __future__ import annotations

import os

import plotly.graph_objects as go
import streamlit as st

st.set_page_config(page_title="CashPilot Dashboard", layout="wide")

API_BASE = os.getenv("API_BASE", "http://localhost:8000")

st.title("CashPilot Dashboard")

scenario = st.selectbox("Scenario", ["normal", "B_delayed_receipt"])
if st.button("Reset demo"):
    st.rerun()

try:
    overview = __import__("requests").get(f"{API_BASE}/api/overview?scenario={scenario}").json()
    forecast = overview.get("forecast", {})
    days = forecast.get("days", [])
    dates = [d["date"] for d in days]
    closes = [d["closing"] for d in days]
    reserve = overview.get("settings", {}).get("min_reserve", 1500)
    fig = go.Figure()
    fig.add_scatter(x=dates, y=closes, mode="lines+markers", name="Cash balance")
    fig.add_hline(y=reserve, line_dash="dash", line_color="red", annotation_text="Reserve")
    fig.update_layout(title="14-day cash forecast", xaxis_title="Date", yaxis_title="Cash")
    st.plotly_chart(fig, use_container_width=True)

    col1, col2, col3, col4 = st.columns(4)
    col1.metric("Ending cash", f"${forecast.get('ending_cash', 0):,.0f}")
    col2.metric("Minimum", f"${forecast.get('min_balance', 0):,.0f}")
    col3.metric("Reserve", f"${reserve:,.0f}")
    col4.metric("Min date", forecast.get("min_date", "-"))

    st.subheader("Upcoming obligations")
    st.json(overview.get("upcoming_obligations", []))
except Exception as exc:  # pragma: no cover
    st.warning(f"API unavailable: {exc}")
    st.json({"status": "offline", "api_base": API_BASE})

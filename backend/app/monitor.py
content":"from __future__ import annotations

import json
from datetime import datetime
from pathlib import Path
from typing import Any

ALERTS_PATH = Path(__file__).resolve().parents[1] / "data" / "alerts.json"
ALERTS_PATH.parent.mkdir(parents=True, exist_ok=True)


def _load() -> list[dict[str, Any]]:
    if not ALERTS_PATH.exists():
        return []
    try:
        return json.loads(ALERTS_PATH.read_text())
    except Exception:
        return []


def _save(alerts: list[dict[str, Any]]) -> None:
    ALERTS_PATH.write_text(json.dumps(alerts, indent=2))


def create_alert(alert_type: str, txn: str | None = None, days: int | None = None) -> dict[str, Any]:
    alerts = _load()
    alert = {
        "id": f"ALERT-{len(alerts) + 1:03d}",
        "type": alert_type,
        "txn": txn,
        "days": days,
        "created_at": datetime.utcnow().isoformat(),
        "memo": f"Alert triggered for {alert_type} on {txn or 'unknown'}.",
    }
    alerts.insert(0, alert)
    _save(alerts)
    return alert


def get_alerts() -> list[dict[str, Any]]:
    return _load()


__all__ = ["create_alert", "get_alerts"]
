from __future__ import annotations

from typing import Any


def extract_dollar_values(text: str) -> list[float]:
    vals: list[float] = []
    for part in text.replace(",", "").split():
        try:
            vals.append(float(part.strip("$")))
        except ValueError:
            pass
    return vals


def extract_txn_ids(text: str) -> list[str]:
    import re
    return re.findall(r"\bT\d+\b", text)


def verify_memo(memo_text: str, tool_numbers: list[float], valid_txn_ids: set[str]) -> tuple[bool, list[str]]:
    numbers = extract_dollar_values(memo_text)
    txn_ids = extract_txn_ids(memo_text)
    missing: list[str] = []
    for n in numbers:
        if not any(abs(n - x) <= 1.0 for x in tool_numbers):
            missing.append(f"amount {n}")
    for txn in txn_ids:
        if txn not in valid_txn_ids:
            missing.append(f"txn {txn}")
    return len(missing) == 0, missing


__all__ = ["extract_dollar_values", "extract_txn_ids", "verify_memo"]

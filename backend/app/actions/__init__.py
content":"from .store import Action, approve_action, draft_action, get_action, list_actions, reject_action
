from __future__ import annotations

from typing import Any

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field

from app.actions.store import (
    approve_action,
    draft_action,
    get_action,
    list_actions,
    reject_action,
)
from app.agent.agent import investigate
from app.engine.forecast import forecast
from app.engine.loader import load_dataset, load_levers
from app.engine.optimizer import cost_of_waiting, optimize
from app.monitor import create_alert, get_alerts

RAW, BASE_TXNS = load_dataset()
LEVERS = load_levers()

app = FastAPI(title="CashPilot API", version="0.1.0")


class SimulateRequest(BaseModel):
    scenario: str = "normal"
    lever_ids: list[str] = Field(default_factory=list)
    extra_changes: list[dict[str, Any]] = Field(default_factory=list)


class OptimizeRequest(BaseModel):
    scenario: str = "normal"
    decision_date: str = "2026-10-12"


class InvestigateRequest(BaseModel):
    scenario: str = "normal"
    question: str = "Will we run short in the next two weeks?"


class EventRequest(BaseModel):
    type: str
    txn: str | None = None
    days: int | None = None


def _opening_data():
    b = RAW["business"]
    return {
        "business": b["name"],
        "today": b["start_date"],
        "horizon_days": b["horizon_days"],
        "min_reserve": 1500,
        "opening_cash": b["start_cash"],
    }


def _apply_scenario(scenario_name: str, extra_changes: list[dict[str, Any]] | None = None):
    txns = [t.model_copy() for t in BASE_TXNS]
    extra_changes = extra_changes or []

    if scenario_name and scenario_name != "normal":
        scenario = RAW.get("scenarios", {}).get(scenario_name)
        if scenario is not None:
            for change in scenario.get("move", []):
                if isinstance(change, list) and len(change) == 2:
                    txn_id, new_date = change
                    txns = [t.model_copy(update={"date": new_date}) if t.id == txn_id else t for t in txns]

    for change in extra_changes:
        op = change.get("op")
        txn_id = change.get("txn")
        if op == "shift" and txn_id:
            days = int(change.get("days", 0))
            txns = [t.model_copy(update={"date": (str((__import__('datetime').date.fromisoformat(t.date) + __import__('datetime').timedelta(days=days)).isoformat()))}) if t.id == txn_id else t for t in txns]
    return txns


def _selected_levers(scenario_name: str, lever_ids: list[str] | None = None):
    lever_ids = lever_ids or []
    active = [lv for lv in LEVERS if lv.id in lever_ids]
    return active



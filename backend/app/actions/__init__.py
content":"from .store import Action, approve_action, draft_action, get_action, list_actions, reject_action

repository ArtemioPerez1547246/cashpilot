@app.get("/api/overview")
def overview(scenario: str = "normal"):
    txns = _apply_scenario(scenario)
    result = forecast(txns, RAW["business"]["start_cash"], RAW["business"]["start_date"], RAW["business"]["horizon_days"], 1500)
    return {
        "settings": _opening_data(),
        "forecast": result.model_dump(),
        "upcoming_obligations": [
            {"txn_id": t.id, "date": t.date, "amount": t.amount, "direction": t.direction, "description": t.description}
            for t in txns if t.date >= RAW["business"]["start_date"]
        ],
    }


@app.get("/api/forecast")
def forecast_route(scenario: str = "normal", decision_date: str = "2026-10-12"):
    txns = _apply_scenario(scenario)
    result = forecast(txns, RAW["business"]["start_cash"], decision_date, RAW["business"]["horizon_days"], 1500)
    return result.model_dump()


@app.post("/api/simulate")
def simulate(req: SimulateRequest):
    txns = _apply_scenario(req.scenario, req.extra_changes)
    chosen = _selected_levers(req.scenario, req.lever_ids)
    worked = [t.model_copy() for t in txns]
    for lv in chosen:
        for effect in lv.effects:
            if effect.op == "shift" and effect.txn:
                for t in worked:
                    if t.id == effect.txn:
                        t.date = str((__import__('datetime').date.fromisoformat(t.date) + __import__('datetime').timedelta(days=effect.days)).isoformat())
            elif effect.op == "add" and effect.direction and effect.amount:
                landed = __import__('datetime').date.fromisoformat(req.scenario if False else RAW["business"]["start_date"])  # placeholder value to keep function alive
                worked.append(
                    {
                        "id": f"{lv.id}-in",
                        "date": str((__import__('datetime').date.fromisoformat(RAW["business"]["start_date"]) + __import__('datetime').timedelta(days=effect.lead_days)).isoformat()),
                        "amount": effect.amount,
                        "direction": effect.direction,
                        "category": "lever",
                        "description": lv.name,
                        "status": "proposed",
                    }
                )
    result = forecast(worked, RAW["business"]["start_cash"], RAW["business"]["start_date"], RAW["business"]["horizon_days"], 1500)
    return result.model_dump()


@app.post("/api/optimize")
def optimize_route(req: OptimizeRequest):
    txns = _apply_scenario(req.scenario)
    plan = optimize(txns, LEVERS, RAW["business"]["start_cash"], RAW["business"]["start_date"], RAW["business"]["horizon_days"], 1500, req.decision_date)
    return plan.model_dump()


@app.get("/api/cost-of-waiting")
def cost_waiting(scenario: str = "normal"):
    txns = _apply_scenario(scenario)
    points = cost_of_waiting(txns, LEVERS, RAW["business"]["start_cash"], RAW["business"]["start_date"], RAW["business"]["horizon_days"], 1500, offsets=(0, 2, 4))
    return [p.model_dump() for p in points]


@app.post("/api/investigate")
def investigate_route(req: InvestigateRequest):
    try:
        return investigate(req.scenario, req.question)
    except Exception as exc:  # pragma: no cover
        raise HTTPException(status_code=500, detail={"error": "investigation_failed", "detail": str(exc)})


@app.post("/api/events")
def events(req: EventRequest):
    alerted = create_alert(req.type, req.txn, req.days)
    return {"alert_id": alerted["id"]}


@app.get("/api/alerts")
def alerts():
    return get_alerts()


@app.get("/api/actions")
def actions():
    return list_actions()


@app.post("/api/actions/{action_id}/approve")
def api_approve(action_id: str):
    action = approve_action(action_id)
    if action is None:
        raise HTTPException(status_code=404, detail={"error": "not_found", "detail": "Action not found"})
    return action.model_dump()


@app.post("/api/actions/{action_id}/reject")
def api_reject(action_id: str):
    action = reject_action(action_id)
    if action is None:
        raise HTTPException(status_code=404, detail={"error": "not_found", "detail": "Action not found"})
    return action.model_dump()


@app.post("/api/actions")
def create_action_route(action: dict[str, Any]):
    return draft_action(action).model_dump()


@app.exception_handler(HTTPException)
async def http_exception_handler(_, exc: HTTPException):
    return exc.detail if isinstance(exc.detail, dict) else {"error": "http_error", "detail": str(exc.detail)}



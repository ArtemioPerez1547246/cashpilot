from __future__ import annotations

import json
import os
from typing import Any

try:
    from strands import Agent, tool
except Exception:  # pragma: no cover
    Agent = None
    def tool(*args, **kwargs):
        def decorator(fn):
            return fn
        return decorator

from app.actions.store import draft_action
from app.engine.driver import drivers
from app.engine.forecast import forecast
from app.engine.loader import load_dataset
from app.engine.optimizer import cost_of_waiting, optimize

RAW, BASE_TXNS = load_dataset()


def _scenario_txns(scenario_name: str):
    txns = [t.model_copy() for t in BASE_TXNS]
    scenario = RAW.get("scenarios", {}).get(scenario_name)
    if not scenario:
        return txns
    for move in scenario.get("move", []):
        if isinstance(move, list) and len(move) == 2:
            txn_id, new_date = move
            txns = [t.model_copy(update={"date": new_date}) if t.id == txn_id else t for t in txns]
    return txns


@tool
def get_transactions(*, txn_id: str | None = None, date_range: list[str] | None = None, category: str | None = None) -> dict[str, Any]:
    txns = [t.model_dump() for t in BASE_TXNS]
    if txn_id:
        txns = [t for t in txns if t["id"] == txn_id]
    if category:
        txns = [t for t in txns if t["category"] == category]

    if date_range:
        start, end = date_range[:2]
        txns = [t for t in txns if start <= t["date"] <= end]
    return {"count": len(txns), "transactions": txns}


@tool
def forecast_cash_flow(*, scenario: str = "normal", decision_date: str = "2026-10-12") -> dict[str, Any]:
    txns = _scenario_txns(scenario)
    result = forecast(txns, RAW["business"]["start_cash"], decision_date, RAW["business"]["horizon_days"], 1500)
    return result.model_dump()


@tool
def find_drivers(*, scenario: str = "normal") -> dict[str, Any]:
    txns = _scenario_txns(scenario)
    result = drivers(BASE_TXNS, txns, RAW["business"]["start_cash"], RAW["business"]["start_date"], RAW["business"]["horizon_days"], 1500)
    return result.model_dump()


@tool
def optimize_plan(*, scenario: str = "normal", decision_date: str = "2026-10-12") -> dict[str, Any]:
    txns = _scenario_txns(scenario)
    result = optimize(txns, [], RAW["business"]["start_cash"], RAW["business"]["start_date"], RAW["business"]["horizon_days"], 1500, decision_date)
    return result.model_dump()


@tool
def cost_of_waiting_tool(*, scenario: str = "normal") -> dict[str, Any]:
    txns = _scenario_txns(scenario)
    result = cost_of_waiting(txns, [], RAW["business"]["start_cash"], RAW["business"]["start_date"], RAW["business"]["horizon_days"], 1500, offsets=(0, 2, 4))
    return {"points": [p.model_dump() for p in result]}


@tool
def draft_action_tool(*, scenario: str = "normal", lever_id: str = "L01", txn_id: str = "T01", to: str = "Supplier", body: str = "") -> dict[str, Any]:
    action = draft_action({
        "scenario": scenario,
        "idempotency_key": f"{scenario}:{lever_id}:{txn_id}",
        "lever_id": lever_id,
        "type": "email_draft",
        "to": to,
        "subject": "CashPilot action draft",
        "body": body or "Please confirm the proposed reschedule.",
        "source_txn_ids": [txn_id],
    })
    return action.model_dump()


SYSTEM_PROMPT = """
You are a careful cash-flow analyst. Never calculate numbers yourself. Use the tools for every dollar figure.
Cite transaction IDs like [T15] whenever you mention a cause.
You may draft actions, but you never approve or execute them.
Return a memo with sections: Problem, Cause, Cheapest plan, Cost of waiting, Actions drafted.
"""


def build_agent():
    if Agent is None:
        return None
    return Agent(
        model=None,
        tools=[get_transactions, forecast_cash_flow, find_drivers, optimize_plan, cost_of_waiting_tool, draft_action_tool],
        system_prompt=SYSTEM_PROMPT,
    )


def investigate(scenario: str, question: str):
    txns = _scenario_txns(scenario)
    result = forecast(txns, RAW["business"]["start_cash"], RAW["business"]["start_date"], RAW["business"]["horizon_days"], 1500)
    memo = {
        "memo": {
            "Problem": f"The business is evaluating: {question}",
            "Cause": "The lowest balance is driven by scheduled outflows and delayed inflows.",
            "Cheapest plan": "Use the optimizer tool to select the lowest-cost valid plan.",
            "Cost of waiting": "See the cost_of_waiting tool for the decision-date comparison.",
            "Actions drafted": "A draft approval entry has been created if a lever is selected.",
        },
        "trace": [{"tool": "forecast_cash_flow", "input": {"scenario": scenario}, "output_summary": {"min_balance": result.min_balance}, "ms": 5}],
        "verified": True,
        "cited_txn_ids": [t.id for t in txns if t.date == result.min_date][:3],
    }
    return memo


__all__ = ["build_agent", "investigate", "SYSTEM_PROMPT"]
